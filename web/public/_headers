# Cloudflare Pages caching rules.
# HTML entry points are never cached so clients always fetch the latest bundle
# (which is content-hashed and can be cached long-term).

/
  Cache-Control: no-cache

/login
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
