# Local development only. Never use these defaults on a public deployment.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27018/lpludo_dev?replicaSet=rs0
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=local-only-access-secret-change-before-deploy-000000
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-deploy-000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://probossludo.com
ALLOW_DEV_OTP=true
DEV_MASTER_OTP=

# MeraOTP.in SMS gateway settings
# Replace this with your testing key before production deployment.
MERAOTP_API_URL=https://meraotp.in/api/v1/otp/send
MERAOTP_VERIFY_API_URL=https://meraotp.in/api/v1/otp/verify
MERAOTP_API_KEY=
MERAOTP_SENDER_ID=
MERAOTP_TEMPLATE_ID=

# IMB Payment gateway settings. Keep the merchant token private in apps/api/.env.
PUBLIC_WEB_URL=http://localhost:5173
IMB_API_URL=https://api.imbpay.in
IMB_API_TOKEN=
IMB_STATUS_MIN_INTERVAL_MS=10000
IMB_ORDER_GRACE_MIN=30

LOCAL_STORAGE_DIR=.local-storage
CONFLICT_REFUND_HOURS=12
ADMIN_PHONE=9999000000
ADMIN_PASSWORD=LocalAdmin123!
ADMIN_NAME=Local Admin
